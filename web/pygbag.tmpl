function show_infobox() {
    loader.style.display = "flex";
}

// Fullscreen for the game. F asks for it here, inside the key press itself: a browser
// only allows fullscreen while it is handling something the player did.
function is_fullscreen() {
    return !!(document.fullscreenElement || document.webkitFullscreenElement);
}

function toggle_fullscreen() {
    const page = document.documentElement;
    const asked = is_fullscreen()
        ? (document.exitFullscreen || document.webkitExitFullscreen).call(document)
        : (page.requestFullscreen || page.webkitRequestFullscreen).call(page);
    if (asked && asked.catch) asked.catch(() => {});
}

window.addEventListener("keydown", (event) => {
    if (event.code === "KeyF" && !event.repeat && !event.ctrlKey && !event.metaKey && !event.altKey)
        toggle_fullscreen();
});

// The first click or key press. The loader would notice it by itself, but only looks every
// two seconds; this lets the game start at once and says that the click was heard.
function engaged() {
    if (window.MM) MM.UME = true;
    if (infobox.className === "ready") {
        infobox.className = "";
        infobox.innerText = "Waking the archive";
    }
}
window.addEventListener("pointerdown", engaged);
window.addEventListener("keydown", engaged);

</script>

